# FORTRAN el3dtriadirecttarg(double[1] rlam, double[1] rmu, double[] triaflat, double[3,nsource] trianorm, int[1] nsource, double[3,nsource] source, int[1] ifcharge, double[] charge, int[1] ifdipole, double[] dipstr, int[1] ifpot, inout double[] pot, int[1] ifstrain, inout double[] strain, int[1] ntarget, double[3,ntarget] target, int[1] ifpottarg, inout double[] pottarg, int[1] ifstraintarg, inout double[] straintarg);

