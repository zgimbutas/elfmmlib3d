# FORTRAN elfmm3dparttarg(inout int[1] ier, int[1] iprec, double[1] rlam, double[1] rmu, int[1] nsource, double[3,nsource] source, int[1] ifcharge, double[] charge, int[1] ifdipole, double[] dipstr, double[3,nsource] dipvec, int[1] ifpot, inout double[] pot, int[1] ifstrain, inout double[] strain, int[1] ntarget, double[3,ntarget] target, int[1] ifpottarg, inout double[] pottarg, int[1] ifstraintarg, inout double[] straintarg);
